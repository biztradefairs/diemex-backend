# Set these in the backend environment. Never expose the auth token in NEXT_PUBLIC_* variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
# Ordinary SMS pass messages use an approved SMS sender or a dedicated Messaging Service.
# Prefer the service when Twilio has assigned your approved DLT sender to its sender pool.
TWILIO_SMS_MESSAGING_SERVICE_SID=
# Alternative: a Twilio-approved alphanumeric sender or SMS-capable Twilio number.
TWILIO_SMS_FROM=
# Legacy numeric sender setting, used only when TWILIO_SMS_FROM is empty.
TWILIO_PHONE_NUMBER=

# SID of your approved visitor-pass content template (HX...).
TWILIO_WHATSAPP_PASS_CONTENT_SID=
# Cloudinary media template: https://res.cloudinary.com/<cloud-name>/image/upload/{{3}}
# mediaPath includes the version, folders and file extension.
TWILIO_WHATSAPP_PASS_VARIABLES={"1":"name","2":"registrationNumber","3":"mediaPath"}

# Only needed if using application-generated WhatsApp OTPs instead of Verify.
TWILIO_WHATSAPP_OTP_CONTENT_SID=
TWILIO_WHATSAPP_OTP_VARIABLES={"1":"otp"}

# Public website origin used in delivered pass links.
FRONTEND_URL=https://www.diemex.in
